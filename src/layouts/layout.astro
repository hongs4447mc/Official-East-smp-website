---
import "../styles/styles.css";
import "../styles/rules.css";

import { ClientRouter } from "astro:transitions";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import Suggestions from "../components/Suggestions.astro";
import Status from "../components/Status.astro";


const { title = "East SMP" } = Astro.props;


const disableTransitions =
	Astro.url.pathname === "/beta-tester-bot";

---


<html lang="en">


<head>


<meta charset="UTF-8">


<meta name="viewport" content="width=device-width, initial-scale=1.0">


<title>{title}</title>



{

	!disableTransitions &&

	<ClientRouter />

}


</head>



<body>




<div id="loading-screen">

	<h1>
		East SMP
	</h1>


	<div class="loading-bar">

		<div class="loading-progress"></div>

	</div>

	<p id="loading-percent">
		0%
	</p>

	<div id="loading-list"></div>




</div>







<Navbar />






	<a 
	class="discord-button" 
	href="https://discord.gg/uSeBnAh5Px" 
	target="_blank"
	>

		Join Discord

	</a>
 






<Suggestions />





<Status />








<div class="page-content main-content">


	<div id="page-content">


		<slot />


	</div>


</div>








<Footer />








<script is:inline>


document.addEventListener(

	"DOMContentLoaded",

	()=>{


		const loader =

		document.getElementById(

			"loading-screen"

		);



		if(loader){


			setTimeout(()=>{


				loader.classList.add(

					"hide"

				);


			},1200);


		}



	}

);


</script>







<!-- LOAD ASTRO CLIENT JAVASCRIPT -->

<script type="module">
	import "../scripts/eastsmp.js";
	import "../scripts/skipLoading.js";
</script>




<script src="../scripts/dropdowns.js"></script>

</body>


</html>