---
import Layout from "../layouts/layout.astro";
import BetaTester from "../components/beta.astro";
import { siteInfo } from "../data/siteInfo.js";
---

<Layout title="East SMP Beta Testing">


<a class="discord-button" href="https://discord.gg/uSeBnAh5Px" target="_blank">
	Join Discord
</a>



<div class="page-content main-content">



<div class="rule-box">

<h1>
	EAST SMP BETA TESTING
</h1>


<p>
	Official East SMP website beta testing page.
</p>


<div class="page-info">

<p>
	Website Version:
	<b>{siteInfo.version}</b>

	<br>

	Last Updated:
	{siteInfo.lastUpdated}
</p>

</div>


</div>




<BetaTester />





<div class="rule-box">

<h2>
	About Beta Testing
</h2>


<p>
	Beta Testers help test new East SMP website updates before they are released.
</p>


<p>
	They check pages, buttons, layouts, and features to find problems.
</p>


<p>
	All bugs and suggestions should be reported before official releases.
</p>


</div>



</div>


</Layout>