<script>
	interface ClientScanResult {
		type: string;
		name: string;
		passed: boolean;
		details: string;
	}

	const clientResults: ClientScanResult[] = [
		{
			type: "Scanner",
			name: "Developer Scanner",
			passed: true,
			details: "Developer scanner interface is online."
		},
		{
			type: "Security",
			name: "Developer Panel",
			passed: true,
			details: "Developer panel interface is available."
		},
		{
			type: "Keyboard",
			name: "Ctrl + B",
			passed: true,
			details: "Developer panel keyboard shortcut is enabled."
		},
		{
			type: "AI",
			name: "AI Scanner",
			passed: false,
			details: "AI scanner integration has not been configured yet."
		}
	];

	const loadingScreen =
		document.getElementById("ai-loading");

	const loadingStatus =
		document.getElementById("loading-status");

	const chatOutput =
		document.getElementById("chat-output");

	const commandInput =
		document.getElementById("command-input") as HTMLInputElement | null;

	const commandForm =
		document.getElementById("command-form") as HTMLFormElement | null;

	const scannerStatus =
		document.getElementById("scanner-status");

	const operationName =
		document.getElementById("operation-name");

	const progressFill =
		document.getElementById("progress-fill");

	const progressNumber =
		document.getElementById("progress-number");

	const progressLabel =
		document.getElementById("progress-label");

	const scoreNumber =
		document.getElementById("score-number");

	const summaryScore =
		document.getElementById("summary-score");

	const mobileMenu =
		document.getElementById("mobile-menu");

	const devSidebar =
		document.getElementById("dev-sidebar");

	function addMessage(
		label: string,
		message: string,
		user = false
	): void {
		if (!chatOutput) return;

		const wrapper =
			document.createElement("div");

		wrapper.className = user
			? "user-message"
			: "ai-message";

		const labelElement =
			document.createElement("div");

		labelElement.className =
			"message-label";

		labelElement.textContent =
			label;

		const messageElement =
			document.createElement("p");

		messageElement.textContent =
			message;

		wrapper.appendChild(
			labelElement
		);

		wrapper.appendChild(
			messageElement
		);

		chatOutput.appendChild(
			wrapper
		);

		chatOutput.scrollTop =
			chatOutput.scrollHeight;
	}

	function updateStatus(
		message: string,
		percentage: number
	): void {
		const safePercentage =
			Math.max(
				0,
				Math.min(
					100,
					percentage
				)
			);

		if (scannerStatus) {
			scannerStatus.textContent =
				`● ${message}`;
		}

		if (operationName) {
			operationName.textContent =
				message;
		}

		if (progressFill) {
			progressFill.style.width =
				`${safePercentage}%`;
		}

		if (progressNumber) {
			progressNumber.textContent =
				`${safePercentage}%`;
		}

		if (scoreNumber) {
			scoreNumber.textContent =
				`${safePercentage}%`;
		}

		if (progressLabel) {
			progressLabel.textContent =
				"Current operation";
		}
	}

	function runCommand(
		command: string
	): void {
		const normalizedCommand =
			command.trim().toUpperCase();

		if (!normalizedCommand) return;

		addMessage(
			"YOU",
			normalizedCommand,
			true
		);

		switch (normalizedCommand) {

			case "SCAN":

				updateStatus(
					"Scanning website...",
					25
				);

				addMessage(
					"AI",
					"Website scan started."
				);

				window.setTimeout(() => {

					updateStatus(
						"Website scan complete",
						75
					);

					const passedCount =
						clientResults.filter(
							(item) =>
								item.passed
						).length;

					addMessage(
						"AI",
						`Scan complete. ${passedCount}/${clientResults.length} tests passed.`
					);

				}, 700);

				break;


			case "ANALYZE":

				updateStatus(
					"Analyzing scan results...",
					80
				);

				addMessage(
					"AI",
					"Analysis complete. One AI Scanner integration issue was detected."
				);

				break;


			case "REPAIR":

				updateStatus(
					"Repair system ready",
					85
				);

				addMessage(
					"AI",
					"Repair system is ready. No automatic changes were applied."
				);

				break;


			case "TEST":

				updateStatus(
					"Running verification tests...",
					90
				);

				addMessage(
					"AI",
					"Verification tests completed successfully."
				);

				break;


			case "SAFETY":

				updateStatus(
					"Safety check complete",
					100
				);

				addMessage(
					"AI",
					"Safety check passed. No changes were applied."
				);

				break;


			case "REPORT": {

				const passedCount =
					clientResults.filter(
						(item) =>
							item.passed
					).length;

				const reportScore =
					Math.round(
						(
							passedCount /
							clientResults.length
						) * 100
					);

				addMessage(
					"AI",
					`Report generated: ${passedCount}/${clientResults.length} tests passed (${reportScore}%).`
				);

				break;
			}


			case "BACKUPS":

				addMessage(
					"AI",
					"Backup manager opened. No backup action was performed."
				);

				break;


			case "RESTORE":

				addMessage(
					"AI",
					"Restore is protected. Authorization is required before any restore action."
				);

				break;


			case "LOGS":

				addMessage(
					"AI",
					"Developer logs are available in the Logs panel."
				);

				break;


			case "SETTINGS":

				addMessage(
					"AI",
					"Developer settings panel selected."
				);

				break;


			case "DANGER":

				addMessage(
					"AI",
					"Danger Zone selected. Destructive actions remain locked."
				);

				break;


			default:

				addMessage(
					"AI",
					`Unknown command "${normalizedCommand}". Try SCAN, ANALYZE, REPAIR, TEST, SAFETY, or REPORT.`
				);

				break;
		}
	}


	/* =====================================================
	   AI COMMAND BUTTONS
	   ===================================================== */

	const commandButtons =
		document.querySelectorAll<HTMLButtonElement>(
			"[data-command]"
		);

	commandButtons.forEach(
		(button: HTMLButtonElement) => {

			button.addEventListener(
				"click",
				() => {

					const command =
						button.dataset.command;

					if (command) {
						runCommand(command);
					}

				}
			);

		}
	);


	/* =====================================================
	   COMMAND FORM
	   ===================================================== */

	if (
		commandForm &&
		commandInput
	) {

		commandForm.addEventListener(
			"submit",
			(event: SubmitEvent) => {

				event.preventDefault();

				const value =
					commandInput.value.trim();

				if (!value) return;

				runCommand(value);

				commandInput.value = "";

			}
		);

	}


	/* =====================================================
	   CTRL + B
	   ===================================================== */

	document.addEventListener(
		"keydown",
		(event: KeyboardEvent) => {

			if (
				event.ctrlKey &&
				event.key.toLowerCase() === "b"
			) {

				event.preventDefault();

				commandInput?.focus();

				addMessage(
					"AI",
					"Developer command input focused with Ctrl + B."
				);

			}

		}
	);


	/* =====================================================
	   MOBILE SIDEBAR
	   ===================================================== */

	mobileMenu?.addEventListener(
		"click",
		() => {

			devSidebar?.classList.toggle(
				"open"
			);

		}
	);


	/* =====================================================
	   LOADING SEQUENCE
	   ===================================================== */

	function finishLoading(): void {

		if (loadingStatus) {
			loadingStatus.textContent =
				"LOADING DASHBOARD...";
		}

		window.setTimeout(
			() => {

				if (loadingStatus) {
					loadingStatus.textContent =
						"READY";
				}

				window.setTimeout(
					() => {

						loadingScreen?.classList.add(
							"hidden"
						);

					},
					250
				);

			},
			650
		);
	}


	window.addEventListener(
		"load",
		finishLoading,
		{ once: true }
	);


	/*
	 * Safety fallback.
	 * This guarantees the loading screen cannot
	 * remain permanently stuck.
	 */

	window.setTimeout(
		() => {

			loadingScreen?.classList.add(
				"hidden"
			);

		},
		2500
	);
</script>