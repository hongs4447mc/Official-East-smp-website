---
import Layout from "../layouts/layout.astro";
import { runWebsiteTests } from "../scripts/Testerbot.js";
---
<Layout title="East SMP Website Tester Bot">

  <div class="rule-box">
    <h1>🧪 East SMP Website Tester Bot</h1>
    <p>Automatically test if the East SMP website is working correctly.</p>
    <button id="start-test">🧪 Start Test</button>
  </div>

  <div class="rule-box">
    <h2>Testing Progress</h2>
    <div class="tester-progress-container" style="background:#eee;height:12px;border-radius:6px;">
      <div id="tester-progress" class="tester-progress-bar" style="height:100%;width:0%;background:#4caf50;border-radius:6px;transition:width 300ms ease;"></div>
    </div>
    <p id="tester-percent">0%</p>
  </div>

  <div class="rule-box">
    <h2>Test Results</h2>
    <div id="tester-results" aria-live="polite">
      <p>Waiting for test...</p>
    </div>
  </div>

  <script type="module">
    // IMPORTANT:
    // This path ALWAYS maps to public/scripts/Testerbot.js
    import { runWebsiteTests } from "../scripts/Testerbot.js";

    const button = document.getElementById("start-test");
    const resultsEl = document.getElementById("tester-results");
    const progressBar = document.getElementById("tester-progress");
    const percent = document.getElementById("tester-percent");

    function setProgress(p) {
      progressBar.style.width = p + "%";
      percent.textContent = p + "%";
    }

    function appendResult(r) {
      const mark = r.passed ? "🟢" : "🔴";
      const p = document.createElement("p");
      p.textContent = `${mark} ${r.type} - ${r.name}`;

      if (r.details) {
        const small = document.createElement("small");
        small.style.display = "block";
        small.style.opacity = "0.85";
        small.textContent = `Details: ${r.details}`;
        p.appendChild(small);
      }

      resultsEl.appendChild(p);
    }

    button?.addEventListener("click", async () => {
      button.disabled = true;
      resultsEl.innerHTML = "<p>Running tests…</p>";
      setProgress(0);

      try {
        const final = await runWebsiteTests(
          (p) => setProgress(p),
          (r) => {
            if (resultsEl.querySelector("p")?.textContent === "Running tests…") {
              resultsEl.innerHTML = "";
            }
            appendResult(r);
          }
        );

        const passedCount = final.filter(t => t.passed).length;
        const finalPct = Math.round((passedCount / final.length) * 100);
        setProgress(finalPct);

        const summary = document.createElement("p");
        summary.style.fontWeight = "700";
        summary.textContent = `Summary: ${passedCount}/${final.length} tests passed (${finalPct}%)`;
        resultsEl.appendChild(summary);

      } catch (err) {
        resultsEl.innerHTML = `<p style="color:crimson">Error: ${err?.message || String(err)}</p>`;
      } finally {
        button.disabled = false;
      }
    });
  </script>

</Layout>
