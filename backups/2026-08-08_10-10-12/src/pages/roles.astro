<style>


.roles-page {

	display:flex;

	gap:30px;

	align-items:flex-start;

	width:90%;

	margin:auto;

}



.roles-content {

	flex:1;

}





.role-tabs {

	order:2;

	position:sticky;

	top:100px;

	width:180px;

	display:flex;

	flex-direction:column;

	gap:10px;

}





.role-tabs a {

	background:#5865F2;

	color:white;

	text-decoration:none;

	padding:12px;

	border-radius:8px;

	text-align:center;

}





.role-tabs a:hover {

	background:#4752C4;

	transform:scale(1.05);

}





section {

	scroll-margin-top:100px;

	margin-bottom:80px;

}






@media(max-width:900px){


.roles-page {

	flex-direction:column;

	width:90%;

}



.role-tabs {

	order:-1;

	position:static;

	width:100%;

	flex-direction:row;

	flex-wrap:wrap;

}



.role-tabs a {

	flex:1;

	min-width:120px;

}


}



</style>


</Layout>