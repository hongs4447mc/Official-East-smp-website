---
import Layout from "../layouts/layout.astro";
import { siteInfo } from "../data/siteInfo.js";
---

<Layout title="Rules - East SMP">


<div class="rules-search">

<input
	id="rule-search"
	type="text"
	placeholder="Search rules..."
>

</div>



<div id="search-results"></div>



<div id="rules-container">


<div class="rule-box full-rule-box">

<h1>
OFFICIAL EAST SMP RULES
</h1>


<h3>
By joining East SMP, you agree to follow these rules.
</h3>



<div class="page-info">

<p>
	Website Version: <b>{siteInfo.version}</b><br>
	Last Updated: {siteInfo.lastUpdated}
</p>

</div>


</div>





<div class="rules-layout">



<div class="rules-content">



<!-- IMPORTANT -->

<div class="rule-box rule-section" id="important">


<h2>⚠️ Important Rules</h2>

<hr>


<div class="rule-item">

<b>No Hacking</b><br>

No hacked clients, cheats, or unfair advantages.

</div>



<div class="rule-item">

<b>No DDoS / Doxxing</b><br>

No attacks, leaking information, or privacy violations.

</div>



<div class="rule-item">

<b>No NSFW Content</b><br>

No inappropriate content.

</div>



<div class="rule-item">

<b>No Threats</b><br>

No threats involving harm, DDoS, doxxing, or SWAT.

</div>



<div class="rule-item">

<b>No Ban Evasion</b><br>

No alternate accounts to avoid punishments.

</div>


</div>






<!-- PUNISHMENTS -->

<div class="rule-box rule-section" id="punishments">


<h2>Punishments</h2>

<hr>



<div class="rule-item">

<b>Staff Decisions</b><br>

Staff decisions must be respected.

</div>



<div class="rule-item">

<b>Permanent Punishments</b><br>

Permanent punishments are final.

</div>



<div class="rule-item">

<b>Punishment Types</b><br>

Warning, Temporary Ban, Permanent Ban.

</div>


</div>







<!-- COMMUNITY -->

<div class="rule-box rule-section" id="community">


<h2>Community Rules</h2>

<hr>



<div class="rule-item">

<b>Respect Players</b><br>

Treat everyone fairly.

</div>



<div class="rule-item">

<b>No Harassment</b><br>

No bullying or targeting players.

</div>



<div class="rule-item">

<b>No Excessive Toxicity</b><br>

Do not create a toxic environment.

</div>



<div class="rule-item">

<b>No Racism / Homophobia</b><br>

No hateful content.

</div>


</div>







<!-- REPORTS -->

<div class="rule-box rule-section" id="reports">


<h2>🚨 Report Rule Breaks</h2>

<hr>



<div class="rule-item">

<b>Username</b><br>

Include the player's username.

</div>



<div class="rule-item">

<b>Evidence</b><br>

Screenshots or videos.

</div>



<div class="rule-item">

<b>Description</b><br>

Explain what happened.

</div>


</div>
<!-- SAFETY -->

<div class="rule-box rule-section" id="security">


<h2>Safety & Security</h2>

<hr>



<div class="rule-item">

<b>No Personal Information</b><br>

Do not share private information.

</div>



<div class="rule-item">

<b>No NSFW Links</b><br>

No inappropriate links.

</div>



<div class="rule-item">

<b>No Alts</b><br>

No alternate accounts to avoid punishment.

</div>


</div>







<!-- EVENTS -->

<div class="rule-box rule-section" id="events">


<h2>Event & Creator Rules</h2>

<hr>



<div class="rule-item">

<b>Event Access</b><br>

Do not join event servers without permission.

</div>



<div class="rule-item">

<b>Event Content</b><br>

Do not post content early.

</div>



<div class="rule-item">

<b>Creator Rules</b><br>

Respect East SMP creators.

</div>


</div>







<!-- EXTRA -->

<div class="rule-box rule-section" id="extra">


<h2>Extra Rules</h2>

<hr>



<div class="rule-item">

<b>Swearing</b><br>

Allowed, but slurs are not allowed.

</div>



<div class="rule-item">

<b>No Politics / Religion</b><br>

Avoid these topics.

</div>



<div class="rule-item">

<b>Common Sense</b><br>

Do not break rules.

</div>


</div>





</div>





<!-- RULE TABS -->

<div class="rule-tabs">


<a href="#important">
Important
</a>


<a href="#punishments">
Punishments
</a>


<a href="#community">
Community
</a>


<a href="#reports">
Reports
</a>


<a href="#security">
Safety
</a>


<a href="#events">
Events
</a>


<a href="#extra">
Extra
</a>


</div>



</div>


</div>







<script is:inline>

document.addEventListener("DOMContentLoaded", () => {


	const search = document.getElementById("rule-search");

	const rules = document.querySelectorAll(".rule-item");

	const rulesContainer = document.getElementById("rules-container");

	const results = document.getElementById("search-results");



	if(!search || !rulesContainer || !results) return;



	search.addEventListener("input", () => {


		const text = search.value.toLowerCase().trim();


		results.innerHTML = "";



		if(text === "") {


			rulesContainer.style.display = "";

			results.style.display = "none";

			return;

		}



		rulesContainer.style.display = "none";

		results.style.display = "block";



		let found = false;



		rules.forEach(rule => {


			if(rule.innerText.toLowerCase().includes(text)) {


				found = true;


				results.innerHTML += `

				<div class="rule-box search-result-box">

					${rule.innerHTML}

				</div>

				`;

			}


		});



		if(!found) {


			results.innerHTML = `

			<div class="rule-box search-result-box">

				<h2>No rules found</h2>

				<p>Try another search.</p>

			</div>

			`;

		}


	});


});


</script>


</Layout>