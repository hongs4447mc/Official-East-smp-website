---
import Layout from "../layouts/layout.astro";
import fs from "fs";

let results = [];

try {

    const data = fs.readFileSync(
        "reports/scanner.json",
        "utf-8"
    );

    results = JSON.parse(data);

}

catch {

    results = [
        {
            type:"⚠️ Scanner",
            name:"No report found",
            passed:false,
            details:"Click New Report first"
        }
    ];

}


const passed = results.filter(
    (r) => r.passed
).length;


const total = results.length;


const score = total
? Math.round((passed / total) * 100)
: 0;

---

<Layout>

<div class="scanner-page">


    <div class="scanner-header">


        <h1>
            🧪 Website Scanner
        </h1>


        <div class="scanner-buttons">


            <button onclick="location.reload()">

                🔄 Refresh Report

            </button>



            <button id="new-report">

                📄 New Report

            </button>


        </div>


    </div>



    <div class="score-box">


        <h2>

            Score: {score}%

        </h2>


        <p>

            {passed}/{total} tests passed

        </p>


    </div>




    <div id="scan-status"></div>




    <div class="results">


    {
        results.map((result) => (

            <div

            class:list={[
                "scan-result",
                result.passed
                ? "success"
                : "failed"
            ]}


            onclick="this.classList.toggle('open')"

            >



                <p>


                    <span>

                    {
                    result.passed
                    ? "🟢"
                    : "🔴"
                    }

                    </span>



                    <strong>

                        {result.type}

                    </strong>


                    -


                    {result.name}



                    <span class="arrow">

                        ▼

                    </span>


                </p>




                <div class="details">


                    <small>

                        {result.details || "No details"}

                    </small>


                    <br />


                    <small>

                        Status:

                        {
                        result.passed
                        ? " Passed"
                        : " Failed"
                        }


                    </small>


                </div>


            </div>


        ))
    }


    </div>


</div>





<script>


const button = document.getElementById(
    "new-report"
);


const status = document.getElementById(
    "scan-status"
);



button?.addEventListener(
"click",
async()=>{


    button.disabled = true;


    status.textContent =
    "⏳ Running scanner...";



    try {


        const response =
        await fetch("/api/scan");



        const data =
        await response.json();



        if(data.success){


            status.textContent =
            "✅ Scan complete! Updating...";



            setTimeout(()=>{


                location.reload();


            },1000);



        }


        else {


            status.textContent =
            "❌ Scan Failed";


            console.log(
                data.output
            );


        }



    }


    catch(error){


        status.textContent =
        "❌ Scanner Error";


        console.error(error);


    }



    button.disabled = false;


});


</script>
<script>

const button =
document.getElementById("new-report");


button?.addEventListener(
"click",
async()=>{


    button.innerText =
    "⏳ Scanning...";


    const response =
    await fetch("/api/scan");


    const data =
    await response.json();


    if(data.success){

        button.innerText =
        "✅ Complete";


        setTimeout(
            ()=>{
                location.reload();
            },
            500
        );


    }
    else{

        button.innerText =
        "❌ Scan Failed";

        console.error(data);

    }


});

</script>
</Layout>